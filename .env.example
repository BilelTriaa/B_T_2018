# =============================================================================
# OTTO System — environment variables (copy to .env at repo root)
# =============================================================================

# --- Database (PostgreSQL) ---
# Connection string for Prisma / NestJS API
DATABASE_URL=postgresql://otto:otto_dev_password@127.0.0.1:5433/otto?schema=public

# --- Authentication ---
# Secret used to sign JWT access tokens (use a long random string in production)
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32
# Access token lifetime (e.g. 8h, 15m)
JWT_EXPIRES_IN=8h

# --- API (NestJS — apps/api) ---
# Port the REST API listens on
API_PORT=4000
# Allowed browser origin for CORS (web app URL)
API_CORS_ORIGIN=http://localhost:5173
# Node environment
NODE_ENV=development

# --- Web (React — apps/web) ---
# Base URL the browser uses to call the API (Vite exposes as VITE_API_BASE_URL)
VITE_API_BASE_URL=http://localhost:4000

# --- Object storage (S3-compatible — MinIO in local dev) ---
# Endpoint URL for S3 API (MinIO default local port)
STORAGE_ENDPOINT=http://127.0.0.1:9000
# Access key (MinIO root user in docker-compose)
STORAGE_ACCESS_KEY=otto
# Secret key (MinIO root password in docker-compose)
STORAGE_SECRET_KEY=otto_minio_password
# Bucket name for ISMS documents and evidence
STORAGE_BUCKET=otto-documents
# AWS region string (required by SDK even for MinIO)
STORAGE_REGION=us-east-1
# Use path-style URLs for MinIO (true for local dev)
STORAGE_FORCE_PATH_STYLE=true

# --- Sync (Intervalid site connectors — future) ---
# Default interval in minutes for scheduled site sync jobs
SYNC_INTERVAL_MINUTES=60
# Shared secret for inbound sync webhooks from site ISMS tools
SYNC_WEBHOOK_SECRET=change-me-sync-webhook-secret

# --- SSO (OIDC / Microsoft Entra ID — production, optional in dev) ---
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:4000/api/v1/auth/oidc/callback
