# =============================================================================
# RTN AXIOME — environment variables (copy to .env at repo root)
# =============================================================================

# --- Database (PostgreSQL) ---
# Docker Compose maps host 5433 → container 5432. Native Postgres uses 5432.
DATABASE_URL=postgresql://axiome:axiome_dev_password@127.0.0.1:5433/axiome?schema=public

# --- Authentication ---
JWT_SECRET=change-me-in-production-use-openssl-rand-base64-32
JWT_EXPIRES_IN=8h

# --- API (NestJS — apps/api) ---
API_PORT=4000
API_CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Web (React — apps/web) ---
# Leave empty to use the Vite /api proxy (recommended).
VITE_API_BASE_URL=

# --- Object storage (S3-compatible — MinIO in local dev) ---
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_ACCESS_KEY=axiome
STORAGE_SECRET_KEY=axiome_minio_password
STORAGE_BUCKET=axiome-documents
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
